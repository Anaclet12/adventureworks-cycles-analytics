# AdventureWorks Analytics API — environment configuration
# Copy this file to `.env` and adjust values for your environment.
# The .env file is gitignored — never commit real secrets.

# --- Application ---
DEBUG=false
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security ---
# CHANGE THIS in any non-local environment.
API_KEY=dev-key-change-in-production

# --- Reference date for Recency computation ---
# Should match the date used during model training.
REFERENCE_DATE=2014-01-01
